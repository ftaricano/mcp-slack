# Slack OAuth Configuration
SLACK_CLIENT_ID=<SLACK_CLIENT_ID>
SLACK_CLIENT_SECRET=<SLACK_CLIENT_SECRET>

# Security Configuration
JWT_SECRET=<32_PLUS_CHAR_RANDOM_STRING>
OAUTH_STATE_SECRET=<32_PLUS_CHAR_RANDOM_STRING>

# Server Configuration
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# Optional: Webhook verification token
SLACK_SIGNING_SECRET=<SLACK_SIGNING_SECRET>

# Optional: Bot token for server-to-server operations
SLACK_BOT_TOKEN=<SLACK_BOT_TOKEN>

# Optional: Redis configuration for session storage
REDIS_URL=redis://localhost:6379

# Optional: durable local file token store path
MCP_SLACK_TOKEN_STORE_PATH=~/.config/mcp-slack/tokens.json

# Optional: local path uploads are disabled by default.
# Enable only for trusted operators and constrain reads to this root.
MCP_SLACK_ALLOW_FILE_PATH_UPLOADS=false
MCP_SLACK_FILE_UPLOAD_ROOT=/tmp/mcp-slack-uploads
MCP_SLACK_MAX_FILE_UPLOAD_BYTES=10485760

# Testing Configuration
ENABLE_E2E_TESTS=0
